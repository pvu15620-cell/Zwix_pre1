-- Hàm tìm kiếm máu chính xác ở cả Character lẫn Player thư mục dữ liệu
local function getHealthData(v, char)
	local hp, maxHp = 100, 100
	
	-- 1. Tìm trong Humanoid chuẩn trước
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hp = hum.Health
		maxHp = hum.MaxHealth
	end
	
	-- 2. Nếu Humanoid không đổi hoặc bị khóa cứng, tìm trong các thư mục chỉ số RPG tùy chỉnh
	local folders = {
		char:FindFirstChild("Stats"), char:FindFirstChild("Data"), char:FindFirstChild("leaderstats"),
		v:FindFirstChild("Stats"), v:FindFirstChild("Data"), v:FindFirstChild("leaderstats")
	}
	
	for _, folder in ipairs(folders) do
		if folder then
			local hpStat = folder:FindFirstChild("Health") or folder:FindFirstChild("HP") or folder:FindFirstChild("CurrentHealth")
			local maxHpStat = folder:FindFirstChild("MaxHealth") or folder:FindFirstChild("MaxHP")
			
			if hpStat and (hpStat:IsA("NumberValue") or hpStat:IsA("IntValue")) then
				hp = hpStat.Value
			end
			if maxHpStat and (maxHpStat:IsA("NumberValue") or maxHpStat:IsA("IntValue")) then
				maxHp = maxHpStat.Value
			end
		end
	end
	
	if maxHp <= 0 then maxHp = 100 end
	return math.max(0, math.floor(hp)), math.floor(maxHp)
end

rs.RenderStepped:Connect(function()
	if espOn then updateESP() end
	if not hpOn then return end

	for _, v in pairs(game.Players:GetPlayers()) do
		if v ~= p and v.Character then
			local char = v.Character
			local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")

			if head and (not hum or hum.Health > -999) then
				local ui = createHPUI(v)
				ui.Holder.Visible = true

				local vector, onScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2.5, 0))
				if onScreen then
					ui.Holder.Position = UDim2.new(0, vector.X - 55, 0, vector.Y - 18)
					
					local hp, maxHp = getHealthData(v, char)
					local hpRatio = math.clamp(hp / maxHp, 0, 1)

					ui.HPFill.Size = UDim2.new(hpRatio, 0, 1, 0)

					local hpColor = Color3.fromRGB(46, 204, 113)
					if hpRatio <= 0.25 then
						hpColor = Color3.fromRGB(231, 76, 60)
					elseif hpRatio <= 0.5 then
						hpColor = Color3.fromRGB(241, 196, 15)
					end
					ui.HPFill.BackgroundColor3 = hpColor

					-- Lấy năng lượng (Energy / Mana)
					local currentEnergy, maxEnergy = 100, 100
					local statsFolder = char:FindFirstChild("Stats") or char:FindFirstChild("Data") or v:FindFirstChild("Data") or v:FindFirstChild("leaderstats")
					local enStat = char:FindFirstChild("Energy") or char:FindFirstChild("Mana") or char:FindFirstChild("Chi") or char:FindFirstChild("Power")
					if not enStat and statsFolder then
						enStat = statsFolder:FindFirstChild("Energy") or statsFolder:FindFirstChild("Mana") or statsFolder:FindFirstChild("Chi") or statsFolder:FindFirstChild("Power")
					end

					if enStat and (enStat:IsA("NumberValue") or enStat:IsA("IntValue")) then
						currentEnergy = enStat.Value
						local maxEnStat = statsFolder and (statsFolder:FindFirstChild("Max"..enStat.Name) or statsFolder:FindFirstChild("MaxEnergy") or statsFolder:FindFirstChild("MaxMana"))
						if maxEnStat then maxEnergy = maxEnStat.Value else maxEnergy = math.max(currentEnergy, 100) end
					end

					local enRatio = math.clamp(currentEnergy / maxEnergy, 0, 1)
					ui.ENFill.Size = UDim2.new(enRatio, 0, 1, 0)

					local dist = 0
					if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						dist = math.floor((p.Character.HumanoidRootPart.Position - head.Position).Magnitude)
					end

					ui.NameTxt.Text = v.Name .. " [" .. dist .. "m]"
					ui.StatTxt.Text = "HP: " .. hp .. " | EN: " .. math.floor(currentEnergy)
				else
					ui.Holder.Visible = false
				end
			else
				removeHPUI(v)
			end
		else
			removeHPUI(v)
		end
	end
end)
